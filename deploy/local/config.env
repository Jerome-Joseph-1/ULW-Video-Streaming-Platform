# The sandbox's operator configuration (deploy/kubernetes/overlays/staging/config.env explains
# each key): the kind cluster that e2e-up.sh makes is just another operator, with the mock
# auth-service as its identity provider and MinIO as its store. Read by cluster/ and
# ../stunner/, each rendering the parts of deploy/kubernetes/base it runs.
NAMESPACE=ulw
GATEWAY_NAME=public-gateway
GATEWAY_NAMESPACE=gateway-system
# The routes answer any host here (cluster/kustomization.yaml removes their hostnames); this
# only has to be a valid one.
PUBLIC_HOSTNAME=sandbox.ulw.test
# kind's default pod network.
POD_CIDR=10.244.0.0/16
JWKS_URL=https://mock-auth.auth.svc.cluster.local/.well-known/jwks.json
JWT_ISSUER=https://auth.ulw-sandbox.test
JWT_AUDIENCE=ulw-sandbox
JWT_SUBJECT_CLAIM=sub
AUTH_COOKIE=auth_token
ALLOWED_ORIGINS=https://sandbox.ulw.test
STORAGE=minio
R2_ACCOUNT_ID=
S3_ENDPOINT=http://minio:9000
BUCKET=ulw-e2e
# Replaced by the images e2e-up.sh builds (cluster/kustomization.yaml).
VIDEO_GATEWAY_IMAGE_TAG=main
VIDEO_WORKER_IMAGE_TAG=main
CHAT_IMAGE_TAG=main
LIVE_PACKAGER_IMAGE_TAG=main
IMAGE_PULL_POLICY=Never
TURN_PORT=3478
VIDEO_GATEWAY_SECRET=video-gateway-secrets
VIDEO_WORKER_SECRET=video-worker-secrets
CHAT_SECRET=chat-secrets
SFU_SECRET=sfu-secrets
LIVE_PACKAGER_SECRET=live-packager-secrets

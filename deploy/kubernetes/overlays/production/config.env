# The operator configuration of one ULW environment: every value that differs from one operator
# (or one environment) to the next, and nothing else. kustomize reads it into the manifests
# (components/operator-config); RUNBOOK.md, step 4, explains each key. It is also a shell file
# (KEY=value, no spaces, no quotes), sourced to fill in the live packager's Job (step 9).
# Every value below is an example: replace each one before the first apply. Secrets never go
# here; they go in the Secrets this file names (step 3).

# Where it runs.
NAMESPACE=ulw
# The live packagers' own namespace (docs/adr/0092, RUNBOOK.md step 9): the gateway may create
# packager Jobs there and nowhere else. NAMESPACE with -live is the usual choice.
LIVE_NAMESPACE=ulw-live
# The Gateway API Gateway in front of the HTTP services (Envoy Gateway), and the one host the
# routes answer: the web app's origin, as clients reach /api, /rt and /rtc.
GATEWAY_NAME=public-gateway
GATEWAY_NAMESPACE=gateway-system
PUBLIC_HOSTNAME=video.example.com
# The pod network: Envoy's pods are in it (the proxies whose X-Forwarded-For is believed), and
# the worker and the live packagers may not reach into it.
POD_CIDR=10.42.0.0/16

# The identity provider whose tokens ULW accepts (docs/integration/auth.md). JWKS_URL is https;
# JWT_ISSUER is compared byte for byte with each token's iss; JWT_AUDIENCE must be in its aud.
# JWT_SUBJECT_CLAIM names the claim that holds the user's id, `sub` unless the provider uses
# another.
JWKS_URL=https://id.example.com/.well-known/jwks.json
JWT_ISSUER=https://id.example.com
JWT_AUDIENCE=ulw
JWT_SUBJECT_CLAIM=sub
# The operator's backend: it grants videos to users (docs/integration/videos-and-playback.md)
# and lists people in chats (docs/integration/chat.md, RUNBOOK step 10), with a token from the
# provider's client-credentials grant whose claim SERVICE_CLAIM (empty: scope) holds
# SERVICE_SCOPE and whose azp or client_id is SERVICE_CLIENT_ID (recommended for the gateway,
# required by chat's service port). Use a scope only the backend's client is granted. Empty
# SERVICE_SCOPE: service calls are off.
SERVICE_CLAIM=
SERVICE_SCOPE=
SERVICE_CLIENT_ID=
# Who may create uploads (docs/integration/uploads.md, ADR-0100): only users whose token's claim
# UPLOADER_CLAIM (empty: scope) holds UPLOADER_SCOPE, which your backend has the identity
# provider put there. Empty UPLOADER_SCOPE: every signed-in user may upload.
UPLOADER_CLAIM=
UPLOADER_SCOPE=
# The cookie a browser's token rides in, and the pages (exact scheme://host[:port], comma
# separated) allowed to use it.
AUTH_COOKIE=auth_token
ALLOWED_ORIGINS=https://video.example.com

# The object store: STORAGE=r2 with R2_ACCOUNT_ID, or STORAGE=minio (any S3-compatible store)
# with S3_ENDPOINT; leave the other one empty. Its keys are in the Secrets.
STORAGE=r2
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
S3_ENDPOINT=
BUCKET=ulw-media

# Which build runs: never a moving tag here (deploy/local/check-image-pins.py fails one). Each is
# a commit SHA that publish-images.yml pushed from main, best with its digest as
# <sha>@sha256:<digest>, copied from that run's summary (RUNBOOK.md, 4a). The SHA below is a
# placeholder that pulls nothing.
VIDEO_GATEWAY_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
VIDEO_WORKER_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
CHAT_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
LIVE_PACKAGER_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
# A pinned build never changes, so there is nothing to pull again.
IMAGE_PULL_POLICY=IfNotPresent

# STUNner's public UDP port. Two environments behind one address need two ports
# (docs/adr/0084): this example shares a node with overlays/staging, which holds 3478.
TURN_PORT=3479

# An external TURN service in place of STUNner (docs/adr/0109, RUNBOOK.md step 7, "External
# TURN"), read only when the overlay lists components/external-turn; TURN_PORT is then unused.
# TURN_PROVIDER is cloudflare (Cloudflare Realtime TURN: TURN_KEY_ID here, its API token in the
# SFU_SECRET as EXTERNAL_TURN_API_TOKEN) or hmac (any TURN server checking TURN REST API
# credentials against a shared secret, such as coturn's use-auth-secret: TURN_URLS here, comma
# separated turn:/turns: URIs, and the secret in the SFU_SECRET as EXTERNAL_TURN_SHARED_SECRET).
# Leave the other provider's key empty: chat and the gateway refuse to start with both.
# TURN_TTL_SECONDS is how long each ticket's credentials last (600 to 172800). LiveKit's media then
# reaches the node on MEDIA_UDP_PORT of MEDIA_PUBLIC_IP, the node's public IPv4 address, from the
# provider's relays only; environments sharing a node need a port each, as for TURN_PORT.
TURN_PROVIDER=cloudflare
TURN_URLS=
TURN_KEY_ID=0123456789abcdef0123456789abcdef
TURN_TTL_SECONDS=14400
MEDIA_PUBLIC_IP=203.0.113.10
MEDIA_UDP_PORT=7883

# The Secrets each service reads (RUNBOOK.md, step 3), created in NAMESPACE.
VIDEO_GATEWAY_SECRET=video-gateway-secrets
VIDEO_WORKER_SECRET=video-worker-secrets
CHAT_SECRET=chat-secrets
SFU_SECRET=sfu-secrets
LIVE_PACKAGER_SECRET=live-packager-secrets

# Live streams through the gateway (RUNBOOK.md, step 9), read only when the overlay lists
# components/live-streams. LIVE_MAX_STREAMS is how many run at once: what egress takes (one by
# default, two with overlays/production's egress), and what the packagers' quota leaves room
# for. LIVE_BROADCASTER_CLAIM, <claim>=<value>, names who may start one: a token whose claim of
# that name is that value (a string equal to it, an array holding it, or true for "true");
# empty, every signed-in user may.
LIVE_MAX_STREAMS=2
LIVE_BROADCASTER_CLAIM=roles=broadcaster

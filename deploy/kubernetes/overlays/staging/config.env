# The operator configuration of one ULW environment: every value that differs from one operator
# (or one environment) to the next, and nothing else. kustomize reads it into the manifests
# (components/operator-config); RUNBOOK.md, step 4, explains each key. It is also a shell file
# (KEY=value, no spaces, no quotes), sourced to fill in the live packager's Job (step 9).
# Every value below is an example: replace each one before the first apply. Secrets never go
# here; they go in the Secrets this file names (step 3).

# Where it runs.
NAMESPACE=ulw-staging
# The live packagers' own namespace (docs/adr/0092, RUNBOOK.md step 9): the gateway may create
# packager Jobs there and nowhere else. NAMESPACE with -live is the usual choice.
LIVE_NAMESPACE=ulw-staging-live
# The Gateway API Gateway in front of the HTTP services (Envoy Gateway), and the one host the
# routes answer: the web app's origin, as clients reach /api, /rt and /rtc.
GATEWAY_NAME=public-gateway
GATEWAY_NAMESPACE=gateway-system
PUBLIC_HOSTNAME=staging.video.example.com
# The pod network: Envoy's pods are in it (the proxies whose X-Forwarded-For is believed), and
# the worker and the live packagers may not reach into it.
POD_CIDR=10.42.0.0/16

# The identity provider whose tokens ULW accepts (docs/integration/auth.md). JWKS_URL is https;
# JWT_ISSUER is compared byte for byte with each token's iss; JWT_AUDIENCE must be in its aud.
# JWT_SUBJECT_CLAIM names the claim that holds the user's id, `sub` unless the provider uses
# another.
JWKS_URL=https://id.example.com/.well-known/jwks.json
JWT_ISSUER=https://id.example.com
JWT_AUDIENCE=ulw-staging
JWT_SUBJECT_CLAIM=sub
# The operator's backend, which grants videos to users (docs/integration/videos-and-playback.md):
# a token from the provider's client-credentials grant whose claim SERVICE_CLAIM holds
# SERVICE_SCOPE. Use a scope only the backend's client is granted. Empty SERVICE_SCOPE: none.
SERVICE_CLAIM=scope
SERVICE_SCOPE=
# The cookie a browser's token rides in, and the pages (exact scheme://host[:port], comma
# separated) allowed to use it.
AUTH_COOKIE=auth_token
ALLOWED_ORIGINS=https://staging.video.example.com

# The object store: STORAGE=r2 with R2_ACCOUNT_ID, or STORAGE=minio (any S3-compatible store)
# with S3_ENDPOINT; leave the other one empty. Its keys are in the Secrets.
STORAGE=r2
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
S3_ENDPOINT=
BUCKET=ulw-staging-media

# Which build runs: a tag publish-images.yml pushed to ghcr.io/jerome-joseph-1/ulw-<service>.
# Staging may follow `main`, pulled again at every restart; a pinned environment names a commit
# SHA, best as <sha>@sha256:<digest> (overlays/production, RUNBOOK.md 4a).
VIDEO_GATEWAY_IMAGE_TAG=main
VIDEO_WORKER_IMAGE_TAG=main
CHAT_IMAGE_TAG=main
LIVE_PACKAGER_IMAGE_TAG=main
IMAGE_PULL_POLICY=Always

# STUNner's public UDP port. Two environments behind one address need two ports
# (docs/adr/0084).
TURN_PORT=3478

# The Secrets each service reads (RUNBOOK.md, step 3), created in NAMESPACE.
VIDEO_GATEWAY_SECRET=video-gateway-secrets
VIDEO_WORKER_SECRET=video-worker-secrets
CHAT_SECRET=chat-secrets
SFU_SECRET=sfu-secrets
LIVE_PACKAGER_SECRET=live-packager-secrets

# Live streams through the gateway (RUNBOOK.md, step 9), read only when the overlay lists
# components/live-streams. LIVE_MAX_STREAMS is how many run at once: what egress takes (one by
# default, two with overlays/production's egress), and what the packagers' quota leaves room
# for. LIVE_BROADCASTER_CLAIM, <claim>=<value>, names who may start one: a token whose claim of
# that name is that value (a string equal to it, an array holding it, or true for "true");
# empty, every signed-in user may.
LIVE_MAX_STREAMS=1
LIVE_BROADCASTER_CLAIM=
